<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Ticket Detail"
        cq:template="/conf/supporttickets/settings/wcm/templates/page-content"
        cq:conf="/conf/supporttickets"
        sling:resourceType="supporttickets/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="supporttickets/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="supporttickets/components/container">
                <ticket_detail
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="supporttickets/components/ticket-detail"/>
            </container>
        </root>
    </jcr:content>
</jcr:root>
